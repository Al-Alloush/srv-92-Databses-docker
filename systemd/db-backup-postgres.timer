[Unit]
Description=Daily trigger for PostgreSQL backup
Documentation=file:///srv/db/BACKUP.md

[Timer]
# Daily at 02:00 server local time.
OnCalendar=*-*-* 02:00:00
# If the machine was off at 02:00, run as soon as it boots.
Persistent=true
# Add 0–5 min jitter so two timers don't fire at the same instant after boot.
RandomizedDelaySec=5min
Unit=db-backup-postgres.service

[Install]
WantedBy=timers.target
